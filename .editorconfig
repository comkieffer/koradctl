# Describe common editor settings.
#
# Editor integration:
#   - CLion: automatically applied
#   - VS Code: Install EditorConfig.EditorConfig

root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
max_line_length = 100

[{*.yaml*,*.yml,.clang-format,.clang-tidy}]
indent_size = 2

[{*.{adoc,md,rst,tex}}]
indent_size = unset
